# Copy to .env.local for local development. Never commit real values.
# In the cloud, these come from each cloud's secret manager via Terraform.

APP_NAME="Personal Budget Planner"
APP_URL=http://localhost:3000

DATABASE_URL=postgres://app:app@localhost:5432/app

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# demo | gemini | anthropic
AI_PROVIDER=demo
AI_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_FALLBACK_TO_DEMO=true
# Embedding model for embed() (default gemini-embedding-2) and the timeout for every model call
AI_EMBED_MODEL=
AI_TIMEOUT_MS=20000

LOG_LEVEL=info

# Apply pending migrations when the server starts (used in the cloud)
MIGRATE_ON_START=false

# Optional, used by `pnpm db:seed` against a running app
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=

# Bank sync. The demo bank is the default. Plaid sandbox switches on only when ALL THREE of these are set
# (in the cloud they come from the secret manager); a missing or invalid one falls back to the demo bank.
# BANK_PROVIDER=demo forces the demo bank. The Plaid base URL is fixed to sandbox in code.
PLAID_CLIENT_ID=
PLAID_SECRET=
# Key that encrypts stored access tokens: 32 random bytes, base64. Generate with: openssl rand -base64 32
TOKEN_ENC_KEY=
# Rotation only: the old key, kept until every stored token has been re-wrapped
TOKEN_ENC_KEY_PREVIOUS=
BANK_PROVIDER=
